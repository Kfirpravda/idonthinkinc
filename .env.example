# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ElevenLabs Configuration (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# YouTube Configuration
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# API Configuration
API_PORT=3001
API_HOST=localhost
API_URL=http://localhost:3001

# Dashboard Configuration
DASHBOARD_PORT=3000
DASHBOARD_HOST=localhost

# Worker Configuration
WORKER_CONCURRENCY=3

# Storage Configuration
STORAGE_PATH=./storage
VIDEO_OUTPUT_PATH=./storage/videos
AUDIO_OUTPUT_PATH=./storage/audio
ASSETS_PATH=./storage/assets

# Workflow Configuration
HUMAN_APPROVAL_REQUIRED=true
WORKFLOW_TIMEOUT=3600000

# FFmpeg Configuration
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# Competitor Research
COMPETITOR_WEBSITE_URL=https://example.com
RESEARCH_TIMEFRAME_DAYS=7

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Development
NODE_ENV=development
